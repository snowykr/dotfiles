# Interactive zsh configuration.
[[ -o interactive ]] || return

typeset -U path
if [[ "$OSTYPE" == darwin* ]]; then
    for directory in /opt/homebrew/bin /usr/local/bin; do
        [[ -d "$directory" ]] && path+=("$directory")
    done
fi
for directory in "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/.opencode/bin" "$HOME/.pyenv/bin" "$HOME/.rbenv/bin"; do
    [[ -d "$directory" ]] && path=("$directory" $path)
done
export PATH
if [[ "$OSTYPE" == darwin* ]] && (( $+commands[brew] )); then
    _dotfiles_brew_prefix=$(brew --prefix)
    [[ -d "$_dotfiles_brew_prefix/opt/openjdk/bin" ]] && path=("$_dotfiles_brew_prefix/opt/openjdk/bin" $path)
    [[ -d "$_dotfiles_brew_prefix/opt/openjdk/include" ]] && export CPPFLAGS="-I$_dotfiles_brew_prefix/opt/openjdk/include"
    [[ -s "$_dotfiles_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$_dotfiles_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
    [[ -s "$_dotfiles_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$_dotfiles_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    unset _dotfiles_brew_prefix
fi

if (( $+commands[pyenv] )); then
    eval "$(pyenv init - zsh)"
fi
if (( $+commands[rbenv] )); then
    eval "$(rbenv init - zsh)"
fi
if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

GJCDEV_REPO="$HOME/Documents/coding/gajae-code-upstream"
_dotfiles_zsh_source=$(readlink "$HOME/.zshrc")
if [[ -n "$_dotfiles_zsh_source" ]]; then
    [[ "$_dotfiles_zsh_source" == /* ]] || _dotfiles_zsh_source="$HOME/$_dotfiles_zsh_source"
    source "${_dotfiles_zsh_source:h}/common.sh"
fi
unset _dotfiles_zsh_source
alias rc='nvim "$HOME/.zshrc"'
alias s='source "$HOME/.zshrc"'

# Preserve Ghostty's current directory across ssh/tmux splits.
_ghostty_osc7_cwd() {
    emulate -L zsh
    local LC_ALL=C
    unsetopt MULTIBYTE
    local value byte hex encoded osc
    local -a fields
    integer i
    # Encode bytes, not codepoints; only the path may retain URI slashes.
    for value in "$USER" "$HOST" "$PWD"; do
        encoded=''
        for (( i = 1; i <= ${#value}; i++ )); do
            byte=${value[i]}
            if [[ "$byte" == [a-zA-Z0-9._~-] || ( ${#fields} == 2 && "$byte" == / ) ]]; then
                encoded+="$byte"
            else
                printf -v hex '%%%02X' "'$byte"
                encoded+="$hex"
            fi
        done
        fields+=("$encoded")
    done
    osc=$'\e]7;file://'"${fields[1]}@${fields[2]}${fields[3]}"$'\a'
    if [[ -n "${TMUX:-}" ]]; then
        osc=${osc//$'\e'/$'\e\e'}
        printf '\ePtmux;%s\e\\' "$osc"
    else
        printf '%s' "$osc"
    fi
}
if [[ -n "${GHOSTTY_RESOURCES_DIR:-}" || "${TERM_PROGRAM:-}" == ghostty ]]; then
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _ghostty_osc7_cwd
    add-zsh-hook chpwd _ghostty_osc7_cwd
fi

# Machine-local overrides live outside this checkout so updates never touch them.
if [ -f "$HOME/.config/dotfiles/local/shell.sh" ]; then
    . "$HOME/.config/dotfiles/local/shell.sh"
fi
