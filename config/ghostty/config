font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-codepoint-map = U+1100-U+11FF,U+3130-U+318F,U+A960-U+A97F,U+AC00-U+D7AF,U+D7B0-U+D7FF=Pretendard
shell-integration-features = cursor,no-sudo,title,no-ssh-env,ssh-terminfo,path
clipboard-read = ask
clipboard-write = allow
copy-on-select = clipboard
macos-option-as-alt = left
macos-titlebar-style = tabs

background = #262427
foreground = #fcfcfa
cursor-color = #fcfcfa
cursor-text = #000000
cursor-style-blink = false
selection-background = #fcfcfa
selection-foreground = #262427

palette = 0=#262427
palette = 1=#ff7272
palette = 2=#bcdf59
palette = 3=#ffca58
palette = 4=#49cae4
palette = 5=#a093e2
palette = 6=#aee8f4
palette = 7=#fcfcfa
palette = 8=#545454
palette = 9=#ff7272
palette = 10=#bcdf59
palette = 11=#ffca58
palette = 12=#49cae4
palette = 13=#a093e2
palette = 14=#aee8f4
palette = 15=#fcfcfa

background-opacity = 1
background-blur = false
scrollback-limit = 100000000
window-inherit-working-directory = true
confirm-close-surface = false
